{
  "entities": {
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized administrator account record.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "Member": {
      "title": "Member",
      "description": "Registered member profile with KYC identifiers and monthly dues metadata.",
      "type": "object",
      "properties": {
        "memberCode": {
          "type": "string",
          "minLength": 3,
          "maxLength": 20,
          "pattern": "^[A-Z0-9\\-]+$"
        },
        "fullName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160
        },
        "phone": {
          "type": "string",
          "minLength": 8,
          "maxLength": 20
        },
        "aadhaarNumber": {
          "type": "string",
          "minLength": 12,
          "maxLength": 14,
          "pattern": "^[0-9]{12}$"
        },
        "panNumber": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[A-Z]{5}[0-9]{4}[A-Z]$"
        },
        "voterId": {
          "type": "string",
          "minLength": 6,
          "maxLength": 20,
          "pattern": "^[A-Z0-9]+$"
        },
        "address": {
          "type": "string",
          "maxLength": 300
        },
        "joinedMonth": {
          "type": "string",
          "minLength": 7,
          "maxLength": 7,
          "pattern": "^[0-9]{4}-[0-9]{2}$"
        },
        "status": {
          "type": "string",
          "enum": ["active", "inactive"]
        },
        "uid": {
          "type": "string",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "memberCode",
        "fullName",
        "email",
        "phone",
        "aadhaarNumber",
        "panNumber",
        "voterId",
        "joinedMonth",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "MonthlyPayment": {
      "title": "MonthlyPayment",
      "description": "Monthly 100 INR payment ledger entry for a specific member and billing month.",
      "type": "object",
      "properties": {
        "memberId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "memberCode": {
          "type": "string",
          "minLength": 3,
          "maxLength": 20,
          "pattern": "^[A-Z0-9\\-]+$"
        },
        "memberName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "memberEmail": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160
        },
        "memberUid": {
          "type": "string",
          "maxLength": 128
        },
        "month": {
          "type": "string",
          "minLength": 7,
          "maxLength": 7,
          "pattern": "^[0-9]{4}-[0-9]{2}$"
        },
        "amount": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": ["paid", "pending"]
        },
        "paymentMode": {
          "type": "string",
          "enum": ["UPI", "Cash", "Bank Transfer", "Online"]
        },
        "receiptNumber": {
          "type": "string",
          "maxLength": 40
        },
        "notes": {
          "type": "string",
          "maxLength": 200
        },
        "paidAt": {
          "type": "string",
          "maxLength": 40
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "memberId",
        "memberCode",
        "memberName",
        "memberEmail",
        "month",
        "amount",
        "status",
        "updatedAt"
      ]
    },
    "WorkspaceSyncConfig": {
      "title": "WorkspaceSyncConfig",
      "description": "Admin-only Google Sheets and Google Drive synchronization metadata.",
      "type": "object",
      "properties": {
        "spreadsheetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "spreadsheetUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "spreadsheetTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "lastSyncedAt": {
          "type": "string",
          "maxLength": 40
        },
        "lastBackupFileId": {
          "type": "string",
          "maxLength": 160
        },
        "lastBackupAt": {
          "type": "string",
          "maxLength": 40
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["spreadsheetId", "spreadsheetUrl", "spreadsheetTitle", "updatedAt"]
    }
  },
  "firestore": {
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Explicit admin access control list."
    },
    "/members/{memberId}": {
      "schema": { "$ref": "#/entities/Member" },
      "description": "Up to 100 registered members with personal KYC details."
    },
    "/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/MonthlyPayment" },
      "description": "Monthly ₹100 payment status records keyed by {memberId}_{YYYY-MM}."
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/WorkspaceSyncConfig" },
      "description": "Admin-only configuration including linked Google Spreadsheet and Drive backup metadata."
    }
  }
}
